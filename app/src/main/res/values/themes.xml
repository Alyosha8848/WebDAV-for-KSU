<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme exists only to give the Activity a window background and to make
  the system bars transparent before Compose takes over; all real theming is done
  in Compose (see ui/theme/Theme.kt).

  The parent is a framework theme on purpose. `Theme.Material3.*` /
  `Theme.MaterialComponents.*` live in the Material Components library, which this
  app deliberately does not depend on (it would be a duplicate of material3).
  A dark variant lives in values-night so the pre-Compose frame matches the
  selected system appearance.
-->
<resources>
    <style name="Theme.DufsBox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
